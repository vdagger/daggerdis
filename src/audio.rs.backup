use cpal::traits::{DeviceTrait, HostTrait, StreamTrait};
use rusty_opus::{OpusDecoder as Decoder, OpusEncoder as Encoder, Application};
use std::sync::atomic::AtomicBool;
use std::sync::Arc;
use std::time::Duration;

pub struct AudioDeviceManager {
    input_device: cpal::Device,
    output_device: cpal::Device,
    sample_rate: u32,
    channels: u16,
}

impl AudioDeviceManager {
    pub fn new() -> Result<Self, Box<dyn std::error::Error>> {
        let host = cpal::default_host();
        let input_device = host.default_input_device().expect("Failed to get default input device");
        let output_device = host.default_output_device().expect("Failed to get default output device");
        
        let sample_rate = 48000;
        let channels = 1;
        
        Ok(AudioDeviceManager {
            input_device,
            output_device,
            sample_rate,
            channels,
        })
    }

    pub fn start_recording(
        &self,
        ptt_flag: Arc<AtomicBool>,
        packet_tx: tokio::sync::mpsc::Sender<Vec<u8>>,
        mixer: std::sync::Arc<crate::mixer::AudioMixer>
    ) -> Result<cpal::Stream, Box<dyn std::error::Error>> {
        let sample_rate = cpal::SampleRate(self.sample_rate);
        let config = cpal::StreamConfig {
            channels: self.channels,
            sample_rate,
            buffer_size: cpal::BufferSize::Default,
        };

        let mut encoder = Encoder::new(48000, 1, Application::Voip).unwrap();

        let stream = self.input_device.build_input_stream(
            &config,
            move |data: &[f32], _: &cpal::InputCallbackInfo| {
                // Добавим отладочный вывод
                if rand::random::<u8>() % 100 == 0 {
                    println!("[ОТЛАДКА ЗВУКА] Входящий буфер получен, размер: {}, пик в микшере: {}", data.len(), mixer.get_input_peak());
                }
                
                let mut buffer = data.to_vec();
                mixer.process_input(&mut buffer);
                
                if ptt_flag.load(std::sync::atomic::Ordering::Relaxed) {
                    let mut packet_buf = vec![0u8; 1024];
                    let frame_size = buffer.len();
                    let encoded_len = encoder.encode(&buffer, frame_size, &mut packet_buf).unwrap();
                    let packet = packet_buf[..encoded_len].to_vec();
                    let _ = packet_tx.blocking_send(packet);
                }
            },
            move |err| {
                eprintln!("Audio input error: {}", err);
            },
            Some(Duration::from_millis(100)),
        )?;

        stream.play()?;
        Ok(stream)
    }

    pub fn start_playback(&self, mixer: std::sync::Arc<crate::mixer::AudioMixer>) -> tokio::sync::mpsc::Sender<Vec<u8>> {
        let (tx, mut rx) = tokio::sync::mpsc::channel::<Vec<u8>>(100);
        
        let output_config = cpal::StreamConfig {
            channels: self.channels,
            sample_rate: cpal::SampleRate(self.sample_rate),
            buffer_size: cpal::BufferSize::Default,
        };

        let mut decoder = Decoder::new(48000, 1).unwrap();
        
        let output_device = self.output_device.clone();
        tokio::spawn(async move {
            let stream = output_device.build_output_stream(
                &output_config,
                move |data: &mut [f32], _: &cpal::OutputCallbackInfo| {
                    if let Ok(packet) = rx.try_recv() {
                        let mut output_f32_buf = vec![0f32; 960];
                        if let Ok(decoded_len) = decoder.decode(&packet, 960, &mut output_f32_buf) {
                            let len = decoded_len.min(data.len());
                            for i in 0..len {
                                data[i] = output_f32_buf[i];
                            }
                            mixer.process_output(0, data);
                        }
                    }
                },
                move |err| {
                    eprintln!("Audio output error: {}", err);
                },
                Some(Duration::from_millis(100)),
            ).unwrap();
            
            stream.play().unwrap();
        });
        
        tx
    }
}